# CASELINE — Supabase configuration
#
# Both variables below must be set together for Phase 9 persistence to
# activate. If either is missing, the game automatically falls back to the
# in-memory/anonymous-cookie store (see lib/game-session/persistence) —
# fully playable, but nothing survives a server restart and there is no
# login. See DATABASE.md for the exact setup steps and the SQL migration
# that must be run before these are set.
#
# Only the publishable key belongs here. Never add a service-role/secret
# key to this project — no code path uses one, on purpose (see
# ARCHITECTURE.md / DATABASE.md).

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# CASELINE — generated case artwork (optional; server-only)
#
# Not required — without both variables below set, CASELINE uses
# procedural art exclusively (see lib/art/generation/active-provider.ts).
# Pilot provider: Cloudflare Workers AI, @cf/black-forest-labs/flux-1-schnell
# (lib/art/generation/providers/cloudflare-provider.ts). See
# GENERATED_ART.md before setting these.
#
# Neither variable may ever be prefixed with NEXT_PUBLIC_ — that would
# ship it to every visitor's browser. Never logged, never stored in a
# Supabase table, never committed to this file with a real value.
# ---------------------------------------------------------------------

# Cloudflare dashboard -> Workers & Pages -> AI -> "Use REST API" panel,
# "Account ID" field (same page you create the API token on below).
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare dashboard -> Workers & Pages -> AI -> "Use REST API" ->
# "Create a Workers AI API Token" (custom token scoped to
# "Workers AI - Read" + "Workers AI - Edit" only — not a Global API Key).
CLOUDFLARE_API_TOKEN=

# Optional — FLUX.1 [schnell] diffusion steps, 1-8, default 4 (Cloudflare's
# own default). Higher costs more neurons for marginal quality gain; kept
# conservative unless explicitly overridden for a quality comparison.
# IMAGE_GENERATION_STEPS=

# ---------------------------------------------------------------------
# CASELINE — automatic portrait generation (pilot; server-only)
#
# When "true", a newly created case automatically queues real portrait
# generation for its victim + primary suspects + a few important
# witnesses (deterministic, guilt-safe selection — never based on who the
# actual culprit is), capped at 6 per case, running after case creation
# via after() so gameplay is never blocked on it. Requires Cloudflare +
# Supabase to already be configured above; harmless no-op if either is
# missing. Never retroactive — only affects cases created while this is
# true. Defaults to false: enable only for a deliberate, small-scale
# local pilot. See GENERATED_ART.md.
#
# Never prefix with NEXT_PUBLIC_ — this must stay server-only, same as
# every other setting in this section.
# ---------------------------------------------------------------------
AUTO_GENERATED_PORTRAITS_ENABLED=false

# ---------------------------------------------------------------------
# CASELINE — automatic crime-scene generation (pilot; server-only)
#
# When "true", a newly created case automatically queues exactly ONE real
# crime-scene environment generation (its own crime location, approved v2
# prompt, unchanged) running after case creation via after() so gameplay
# is never blocked on it. Independent from
# AUTO_GENERATED_PORTRAITS_ENABLED above — either can be on/off in any
# combination. Requires Cloudflare + Supabase to already be configured
# above; harmless no-op if either is missing. Never retroactive — only
# affects cases created while this is true. Defaults to false: enable
# only for a deliberate, small-scale local pilot. See GENERATED_ART.md.
#
# Never prefix with NEXT_PUBLIC_ — this must stay server-only, same as
# every other setting in this section.
# ---------------------------------------------------------------------
AUTO_GENERATED_CRIME_SCENES_ENABLED=false
